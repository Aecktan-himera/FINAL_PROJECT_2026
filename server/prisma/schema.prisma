// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  new_user
  verified_user
  team_lead
  admin
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique @db.VarChar(50)
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  firstName    String?    @map("firstname") @db.VarChar(100)
  surname      String?    @db.VarChar(100)
  role         SystemRole @default(new_user)
  avatarUrl    String?    @map("avatar_url") @db.Text
  location     String?    @db.VarChar(255)
  bio          String?    @db.Text
  skills       Json?      @db.JsonB
  settings     Json?      @db.JsonB
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")

  tokens              Token[]
  tabsState           UserTabsState?
  ownedProjects       Project[]           @relation("ProjectOwner")
  projectMembers      ProjectMember[]
  comments            Comment[]
  notifications       Notification[]
  meetings            Meeting[]           @relation("MeetingOrganizer")
  attachments         Attachment[]

  authoredTasks       Task[]              @relation("TaskAuthor")
  assignedTasks       Task[]              @relation("TaskAssignee")
  responsibleProjects Project[]           @relation("ProjectResponsible")
  taskHistoryChanges  TaskHistory[]       @relation("TaskHistoryChanger")
  meetingParticipations MeetingParticipant[] @relation("MeetingParticipantUser")
  gitTokens           GitUserToken[]      @relation("GitUserTokenUser")

  @@map("users")
}

model Token {
  id          String   @id @default(uuid()) @db.Uuid
  token       String   @db.Text
  jti         String   @db.VarChar(255)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz()
  blacklisted Boolean  @default(false)
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tokens")
}

model Project {
  id               String   @id @default(uuid()) @db.Uuid
  parentProjectId  String?  @map("parent_project_id") @db.Uuid
  parentProject    Project? @relation("ProjectHierarchy", fields: [parentProjectId], references: [id])
  children         Project[] @relation("ProjectHierarchy")
  name             String
  key              String   @unique
  description      String?
  isPublic         Boolean  @default(false) @map("is_public")
  ownerId          String   @map("owner_id") @db.Uuid
  owner            User     @relation("ProjectOwner", fields: [ownerId], references: [id])
  responsibleId    String?  @map("responsible_id") @db.Uuid
  responsible      User?    @relation("ProjectResponsible", fields: [responsibleId], references: [id])
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt      @map("updated_at")

  members          ProjectMember[]
  boards           Board[]
  tags             Tag[]
  meetings         Meeting[]
  gitRepositories  GitRepository[]

  @@map("projects")
}

model ProjectMember {
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectRole String   @default("viewer") @map("project_role") // owner, team_lead, developer, viewer
  joinedAt    DateTime @default(now()) @map("joined_at")

  @@id([projectId, userId])
  @@map("project_members")
}

model Board {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  columns   Column[]
  tasks     Task[]

  @@map("boards")
}

model Column {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @map("board_id") @db.Uuid
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name      String
  position  Int      @default(0)
  color     String   @default("#808080")
  wipLimit  Int      @default(0) @map("wip_limit")
  createdAt DateTime @default(now()) @map("created_at")

  tasks     Task[]

  @@map("columns")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#cccccc")

  taskTags  TaskTag[]

  @@map("tags")
}

model Task {
  id          String   @id @default(uuid()) @db.Uuid
  boardId     String   @map("board_id") @db.Uuid
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  columnId    String?  @map("column_id") @db.Uuid
  column      Column?  @relation(fields: [columnId], references: [id], onDelete: SetNull)
  parentTaskId String? @map("parent_task_id")
  parentTask  Task?    @relation("TaskHierarchy", fields: [parentTaskId], references: [id])
  subtasks    Task[]   @relation("TaskHierarchy")
  title       String
  description String?
  authorId    String   @map("author_id") @db.Uuid
  author      User     @relation("TaskAuthor", fields: [authorId], references: [id])
  assigneeId  String?  @map("assignee_id") @db.Uuid
  assignee    User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  priority    String   @default("medium")
  dueDate     DateTime? @map("due_date")
  position    String   // fractional index
  isCompleted Boolean  @default(false) @map("is_completed")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  comments    Comment[]
  taskTags    TaskTag[]
  history     TaskHistory[]
  attachments Attachment[]

  @@map("tasks")
}

model TaskTag {
  taskId String @map("task_id") @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId  String @map("tag_id") @db.Uuid
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id") @db.Uuid
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("comments")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  taskId    String?  @map("task_id") @db.Uuid
  projectId String?  @map("project_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model TaskHistory {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy String   @map("changed_by") @db.Uuid
  changer   User     @relation("TaskHistoryChanger", fields: [changedBy], references: [id])
  fieldName String   @map("field_name")
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  changedAt DateTime @default(now()) @map("changed_at")

  @@map("task_history")
}

model Meeting {
  id            String   @id @default(uuid()) @db.Uuid
  taskId        String?  @map("task_id") @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizerId   String   @map("organizer_id") @db.Uuid
  organizer     User     @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  topic         String
  description   String?
  startTime     DateTime @map("start_time")
  endTime       DateTime @map("end_time")
  zoomMeetingId String?  @map("zoom_meeting_id")
  zoomJoinUrl   String?  @map("zoom_join_url")
  zoomStartUrl  String?  @map("zoom_start_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  participants  MeetingParticipant[]

  @@map("meetings")
}

model MeetingParticipant {
  meetingId      String   @map("meeting_id") @db.Uuid
  meeting        Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId         String   @map("user_id") @db.Uuid
  user           User     @relation("MeetingParticipantUser", fields: [userId], references: [id])
  responseStatus String   @default("pending") @map("response_status")

  @@id([meetingId, userId])
  @@map("meeting_participants")
}

model GitRepository {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  githubRepoId   BigInt   @map("github_repo_id")
  webhookSecret  String?  @map("webhook_secret")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  branches       GitBranch[]
  pullRequests   GitPullRequest[]
  commits        GitCommit[]

  @@map("git_repositories")
}

model GitBranch {
  id           String   @id @default(uuid()) @db.Uuid
  repositoryId String   @map("repository_id") @db.Uuid
  repository   GitRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  name         String
  taskId       String?  @map("task_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("git_branches")
}

model GitPullRequest {
  id                  String   @id @default(uuid()) @db.Uuid
  repositoryId        String   @map("repository_id") @db.Uuid
  repository          GitRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  githubPrId          BigInt   @map("github_pr_id")
  number              Int
  title               String
  state               String   // open, closed, merged
  branchId            String?  @map("branch_id") @db.Uuid
  taskId              String?  @map("task_id") @db.Uuid
  authorGithubUsername String  @map("author_github_username")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt      @map("updated_at")
  mergedAt            DateTime? @map("merged_at")

  commits             GitCommit[]

  @@map("git_pull_requests")
}

model GitCommit {
  id                  String   @id @default(uuid()) @db.Uuid
  repositoryId        String   @map("repository_id") @db.Uuid
  repository          GitRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  sha                 String
  message             String
  authorGithubUsername String  @map("author_github_username")
  taskId              String?  @map("task_id") @db.Uuid
  pullRequestId       String?  @map("pull_request_id") @db.Uuid
  pullRequest         GitPullRequest? @relation(fields: [pullRequestId], references: [id])
  committedAt         DateTime @map("committed_at")

  @@map("git_commits")
}

model GitUserToken {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  user            User     @relation("GitUserTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  accessToken     String   @map("access_token") // store encrypted
  githubUsername  String   @map("github_username")
  createdAt       DateTime @default(now()) @map("created_at")
  expiresAt       DateTime? @map("expires_at")

  @@map("git_user_tokens")
}

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  bucket       String   @db.VarChar(100)
  objectKey    String   @map("object_key") @db.VarChar(500)
  originalName String?  @map("original_name") @db.VarChar(255)
  mimeType     String?  @map("mime_type") @db.VarChar(100)
  sizeBytes    Int      @map("size_bytes")
  uploadedBy   String   @map("uploaded_by") @db.Uuid
  taskId       String?  @map("task_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User   @relation(fields: [uploadedBy], references: [id])
  task Task?  @relation(fields: [taskId], references: [id])

  @@map("attachments")
}

model UserTabsState {
  userId    String   @id @map("user_id") @db.Uuid
  tabs      Json     @map("tabs") // массив вкладок
  activeId  String?  @map("active_id") // id активной вкладки
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_tabs_state")
}

